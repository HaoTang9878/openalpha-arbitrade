# OpenAlpha 套利系统环境变量配置示例
# 复制此文件为 .env 并填入真实值

# === 套利策略参数 ===
MIN_PROFITABILITY=0.0005
ORDER_AMOUNT=0.01
SCAN_INTERVAL=3
MAX_ORDERAGE=180
PAPER_TRADE=true

# === 交易所 API 密钥 ===
# 仅在实盘交易时需要配置（PAPER_TRADE=false）
# API Key 需要开启"交易"权限，不需要"提币"权限

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OKX
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Gate
GATE_API_KEY=
GATE_API_SECRET=
