# OpenAlpha 套利系统环境变量配置示例
# 复制此文件为 .env 并填入真实值

# === 套利策略参数 ===
MIN_PROFITABILITY=0.001
ORDER_AMOUNT=0.01
SCAN_INTERVAL=3
MAX_ORDER_AGE=60
PAPER_TRADE=true

# === 安全配置 ===
# API 管理令牌（写/执行操作需 Bearer token，不配置则拒绝所有写操作）
ARBITRAGE_API_TOKEN=
# JWT 签名密钥（用户认证，不配置则使用不安全的默认值）
JWT_SECRET_KEY=

# === 交易所 API 密钥 ===
# 仅在实盘交易时需要配置（PAPER_TRADE=false）
# API Key 需要开启"交易"权限，不需要"提币"权限

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OKX
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Gate
GATE_API_KEY=
GATE_API_SECRET=

# === Telegram 告警（可选） ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 净利润率达到此阈值才发送机会告警（默认 0.002 = 0.2%）
TELEGRAM_MIN_PROFIT_ALERT=0.002

# === 客户端配置 ===
# 前端 API 基础地址（本地开发用 127.0.0.1，生产环境用域名）
ARBITRAGE_API_BASE=http://127.0.0.1:8070
